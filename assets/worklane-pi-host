#!/bin/sh
set -eu
settings="$HOME/.config/worklane/pi-codex"
if [ ! -r "$settings/model" ]; then
  echo "Pi model is missing; run worklane credentials status" >&2
  exit 2
fi
model="$(cat "$settings/model")"
# Authentication belongs to the owner. The host Pi CLI has its own agent
# directory; do not load a legacy OpenRouter key as an implicit fallback.
exec /usr/local/bin/pi --provider openai-codex --model "$model" --thinking medium "$@"
