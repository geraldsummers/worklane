#!/bin/sh
# Normal Pi configuration is authoritative; this is the Herdr lifecycle entry,
# not a second provider/auth environment or an argument-filtering wrapper.
set -eu
/usr/local/lib/worklane/worklane-pi-install
mkdir -p "$HOME/.tmp"
export TMPDIR="$HOME/.tmp"
if [ -n "${WORKLANE_RUN_ID:-}" ]; then
  # Automatic runs use an explicit audited extension set for budget accounting.
  # Interactive Pi retains normal user/project resource discovery and trust.
  integration="$HOME/.pi/agent/extensions/herdr-agent-state.ts"
  test -f "$integration" || { echo 'Managed Pi requires Herdr integration' >&2; exit 1; }
  exec "$HOME/.local/bin/pi" --no-extensions \
    --extension "$HOME/.local/lib/node_modules/pi-web-access" \
    --extension "$HOME/.pi/agent/extensions/worklane/subscription.ts" \
    --extension "$HOME/.pi/agent/extensions/worklane/questionnaire.ts" \
    --extension "$HOME/.pi/agent/extensions/worklane/plans.ts" \
    --extension "$HOME/.pi/agent/extensions/worklane/collab.ts" \
    --extension "$HOME/.pi/agent/extensions/worklane/p0.ts" \
    --extension "$HOME/.pi/agent/extensions/worklane/complain.ts" \
    --extension "$HOME/.pi/agent/extensions/worklane/notifications.ts" \
    --extension "$integration" "$@"
fi
exec "$HOME/.local/bin/pi" "$@"
