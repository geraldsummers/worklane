# TUI visual capture uses a real PTY and the candidate lane binary on the lab host.
python3 - "$LOCAL_ROOT/scenario.json" "$LAB_SSH" "$R '$REMOTE_ROOT/bin/worklane' --json lane create '$DISCOVERY_NAME' --project '$REMOTE_ROOT/discovery' --profile acceptance" "$LANE_NAME" <<'PY'
import json, sys
path, target, discovery, lane = sys.argv[1:]
ssh = ["/usr/bin/ssh", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=yes", target, discovery]
steps = [
    {"name":"navigation","keys":"jk","wait":1},
    {"name":"filter","keys":"/accept\r","wait":1},
    {"name":"registry-discovery","exec":ssh,"keys":"r","wait":4},
    {"name":"inspect","keys":"i","until":"inspect: completed","timeout":120}, {"name":"close-inspect","keys":"\u001b","wait":1},
    {"name":"diff","keys":"d","until":"diff: completed","timeout":120}, {"name":"close-diff","keys":"\u001b","wait":1},
    {"name":"stop","keys":"x","until":"stop: completed","timeout":120},
    {"name":"start","keys":"s","until":"start: completed","timeout":120},
    {"name":"refresh","keys":"r","wait":3},
    {"name":"rename","keys":"n" + lane + "-tui\r","until":"rename: completed","timeout":120},
    {"name":"reconcile","keys":"c","wait":3},
    {"name":"reconcile-confirm","keys":"C","wait":1}, {"name":"reconcile-cancel","keys":"n","wait":1},
    {"name":"delete-confirm","keys":"D","wait":1}, {"name":"delete-cancel","keys":"n","wait":1},
    {"name":"forget-confirm","keys":"F","wait":1}, {"name":"forget-cancel","keys":"n","wait":1},
    {"name":"editor","keys":"e","wait":2},
    {"name":"shell-attach","keys":"S","wait":3}, {"name":"shell-exit","keys":"exit\r","wait":4},
    {"name":"herdr-attach","keys":"a","wait":5},
    {"name":"herdr-onboarding","keys":"\r","wait":2},
    {"name":"herdr-close-settings","keys":"\u001b","wait":2},
    {"name":"herdr-prefix","keys":"\u0002","wait":1}, {"name":"herdr-detach","keys":"q","wait":4},
    {"name":"upgrade","keys":"u","until":"upgrade: finished — 1 lane outcome; details below","timeout":180},
    {"name":"upgrade-all","keys":"\u001bU","until":"upgrade all: finished — 2 lane outcomes; details below","timeout":1800},
]
open(path, "w").write(json.dumps({"startup_wait":4,"steps":steps}))
PY
python3 "$ROOT/scripts/tui_capture.py" --out "$ARTIFACT_DIR/tui" --scenario "$LOCAL_ROOT/scenario.json" /usr/bin/ssh -tt -o BatchMode=yes -o StrictHostKeyChecking=yes "$LAB_SSH" "$R EDITOR=true '$REMOTE_ROOT/bin/lane'"
grep -Fq 'Worklane lanes' "$ARTIFACT_DIR/tui/26-herdr-detach.txt"
