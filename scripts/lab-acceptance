#!/usr/bin/env bash
set -Eeuo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
CANDIDATE_WORKLANE=${1:?usage: lab-acceptance WORKLANE_BIN LANE_BIN WORKLANE_MCP_BIN ARTIFACT_DIR}
CANDIDATE_LANE=${2:?usage: lab-acceptance WORKLANE_BIN LANE_BIN WORKLANE_MCP_BIN ARTIFACT_DIR}
CANDIDATE_WORKLANE_MCP=${3:?usage: lab-acceptance WORKLANE_BIN LANE_BIN WORKLANE_MCP_BIN ARTIFACT_DIR}
ARTIFACT_DIR=${4:?usage: lab-acceptance WORKLANE_BIN LANE_BIN WORKLANE_MCP_BIN ARTIFACT_DIR}
LAB_SSH=${WORKLANE_LAB_SSH:-podman_lab@192.168.0.11}
RUN_ID=${WORKLANE_ACCEPTANCE_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-$$}
# An explicit key may reuse previously built identical candidate layers during
# an infrastructure/assertion-only retry; default runs still resolve fresh tools.
BUILD_CACHE_KEY=${WORKLANE_ACCEPTANCE_BUILD_CACHE_KEY:-$RUN_ID}
[[ $BUILD_CACHE_KEY =~ ^[A-Za-z0-9._-]+$ ]] || { echo 'invalid build cache key' >&2; exit 1; }
MIN_FREE_KIB=${WORKLANE_ACCEPTANCE_MIN_FREE_KIB:-8388608}
[[ $MIN_FREE_KIB =~ ^[0-9]+$ ]] || { echo 'invalid acceptance free-space floor' >&2; exit 1; }
LOCAL_TMPDIR=${TMPDIR:-/home/dev/.tmp}
mkdir -p "$LOCAL_TMPDIR"
[[ -w $LOCAL_TMPDIR ]] || { echo "acceptance temporary directory is not writable: $LOCAL_TMPDIR" >&2; exit 1; }
LOCAL_ROOT=$(mktemp -d "$LOCAL_TMPDIR/worklane-acceptance-${RUN_ID}.XXXXXX")
SSH_OPTIONS=(-o BatchMode=yes -o StrictHostKeyChecking=yes)
REMOTE_HOME=$(/usr/bin/ssh "${SSH_OPTIONS[@]}" "$LAB_SSH" 'printf %s "$HOME"')
[[ $REMOTE_HOME =~ ^/[A-Za-z0-9._/-]+$ ]] || { echo "unsafe remote home: $REMOTE_HOME" >&2; exit 1; }
REMOTE_ROOT="$REMOTE_HOME/.local/share/worklane/acceptance/$RUN_ID"
LANE_NAME="accept-${RUN_ID//[^A-Za-z0-9]/-}"; LANE_NAME=${LANE_NAME:0:48}
SESSION_NAME="$LANE_NAME"
REMOTE_PROJECT="$REMOTE_ROOT/project"
REMOTE_DISCOVERY="$REMOTE_ROOT/discovery"
REMOTE_SMOKE="$REMOTE_ROOT/image-smoke"
DISCOVERY_NAME="${LANE_NAME}-discovery"
IMAGE_TAG="localhost/worklane-acceptance:$RUN_ID"
SMOKE_IMAGE_TAG="localhost/worklane-acceptance-smoke:$RUN_ID"
PASS_FILE="$ARTIFACT_DIR/passed-features.txt"
LOG="$ARTIFACT_DIR/commands.log"
ACCEPTANCE_SUCCEEDED=0
OLD_DEPLOY_TARGET=
mkdir -p "$ARTIFACT_DIR" "$LOCAL_ROOT/bin" "$LOCAL_ROOT/data" "$LOCAL_ROOT/config"
: >"$PASS_FILE"; : >"$LOG"
TIMING_FILE="$ARTIFACT_DIR/timings.tsv"
printf 'phase\tstarted_utc\tended_utc\tduration_ms\n' >"$TIMING_FILE"
phase_start() {
  PHASE_NAME=$1
  PHASE_START_NS=$(date +%s%N)
  PHASE_START_UTC=$(date -u +%Y-%m-%dT%H:%M:%SZ)
}
phase_end() {
  local end_ns end_utc
  end_ns=$(date +%s%N)
  end_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  printf '%s\t%s\t%s\t%s\n' "$PHASE_NAME" "$PHASE_START_UTC" "$end_utc" "$(((end_ns - PHASE_START_NS) / 1000000))" >>"$TIMING_FILE"
}

redact() { sed -u -E 's/(gh[pousr]_[A-Za-z0-9_]+|github_pat_[A-Za-z0-9_]+)/<redacted>/g'; }
run() { printf '$'; printf ' %q' "$@"; printf '\n' | tee -a "$LOG"; "$@" 2>&1 | redact | tee -a "$LOG"; }
pass() { printf '%s\n' "$1" >>"$PASS_FILE"; }
remote() { run /usr/bin/ssh "${SSH_OPTIONS[@]}" "$LAB_SSH" "$@"; }

cleanup() {
  set +e
  if [[ $ACCEPTANCE_SUCCEEDED != 1 && ${WORKLANE_ACCEPTANCE_PRESERVE_FAILED:-0} == 1 && ${1:-} != acceptance-complete ]]; then
    printf 'Failed acceptance state retained: %s\n' "$REMOTE_ROOT" >>"$LOG"
    return
  fi
  case "$REMOTE_ROOT" in "$REMOTE_HOME"/.local/share/worklane/acceptance/*) ;; *) return 1;; esac
  remote "for lane in '$LANE_NAME' '$DISCOVERY_NAME'; do env XDG_DATA_HOME='$REMOTE_ROOT/data' XDG_CONFIG_HOME='$REMOTE_ROOT/config' PATH='$REMOTE_ROOT/bin:/usr/local/bin:/usr/bin:/bin' '$REMOTE_ROOT/bin/worklane' --json lane delete \"\$lane\" >/dev/null 2>&1 || true; for container in \$(/usr/bin/podman ps -aq --filter \"label=io.worklane.name=\$lane\"); do /usr/bin/podman rm -f \"\$container\" >/dev/null 2>&1 || true; done; done; /usr/bin/podman rmi '$IMAGE_TAG' '$SMOKE_IMAGE_TAG' >/dev/null 2>&1 || true; if test -d '$REMOTE_ROOT/data/containers/storage'; then XDG_DATA_HOME='$REMOTE_ROOT/data' /usr/bin/podman system reset -f >/dev/null 2>&1 || true; fi; /usr/bin/podman unshare rm -rf -- '$REMOTE_ROOT'" >>"$LOG" 2>&1
  if [[ $ACCEPTANCE_SUCCEEDED != 1 && -n $OLD_DEPLOY_TARGET ]]; then
    remote "ln -sfn -- '$OLD_DEPLOY_TARGET' \"\$HOME/.local/bin/worklane\"" >>"$LOG" 2>&1
  fi
  if [[ ${WORKLANE_ACCEPTANCE_KEEP:-0} != 1 ]]; then rm -rf "$LOCAL_ROOT"; fi
}
trap cleanup EXIT

phase_start remote_setup
remote "set -eu; command -v podman; command -v gh; command -v script; test \"\$(df -Pk '$REMOTE_HOME' | awk 'NR==2 {print \$4}')\" -ge '$MIN_FREE_KIB' || { echo 'lab free-space floor not met' >&2; exit 1; }; mkdir -p '$REMOTE_ROOT/bin' '$REMOTE_PROJECT' '$REMOTE_DISCOVERY' '$REMOTE_SMOKE' '$REMOTE_ROOT/data' '$REMOTE_ROOT/config/worklane' '$REMOTE_ROOT/credentials/codex' '$REMOTE_ROOT/credentials/gh'; printf '%s\n' '{\"OPENAI_API_KEY\":\"worklane-acceptance-fixture\"}' >'$REMOTE_ROOT/credentials/codex/auth.json'; printf '%s\n' 'github.com:' '    user: worklane-acceptance' '    oauth_token: worklane-acceptance-fixture' '    git_protocol: https' >'$REMOTE_ROOT/credentials/gh/hosts.yml'; printf '%s\n' '#!/bin/sh' 'unset XDG_DATA_HOME' 'exec /usr/bin/podman \"\$@\"' >'$REMOTE_ROOT/bin/podman'; chmod 755 '$REMOTE_ROOT/bin/podman'; printf '%s\n' '[profiles.acceptance]' 'image = \"$IMAGE_TAG\"' 'embedded_containerfile = false' 'runtime = \"systemd\"' 'network = \"outbound\"' 'mount_codex_credentials = true' 'mount_gh_credentials = true' >'$REMOTE_ROOT/config/worklane/profiles.toml'"
run scp "${SSH_OPTIONS[@]}" -q "$CANDIDATE_WORKLANE" "$CANDIDATE_LANE" "$CANDIDATE_WORKLANE_MCP" "$LAB_SSH:$REMOTE_ROOT/bin/"
# Change the build recipe before its package-install layer so every run resolves current tools.
# The same recipe is reused by lane upgrades, allowing those later builds to use cache.
python3 - "$ROOT/Containerfile" "$LOCAL_ROOT/Containerfile" "$BUILD_CACHE_KEY" <<'PYCONTAINERFILE'
from pathlib import Path
import sys
source, destination, run_id = sys.argv[1:]
content = Path(source).read_text()
needle = "RUN apt-get update"
assert content.count(needle) == 1
cache_key = f'ARG WORKLANE_ACCEPTANCE_RUN_ID={run_id}\nRUN test "$WORKLANE_ACCEPTANCE_RUN_ID" = "{run_id}"\n'
Path(destination).write_text(content.replace(needle, cache_key + needle, 1))
PYCONTAINERFILE
run scp "${SSH_OPTIONS[@]}" -q "$LOCAL_ROOT/Containerfile" "$LAB_SSH:$REMOTE_PROJECT/Containerfile"
remote "mkdir -p '$REMOTE_PROJECT/assets'"
run scp "${SSH_OPTIONS[@]}" -qr "$ROOT/assets/pi-bundle" "$ROOT/assets/worklane-runtime" "$ROOT/assets/worklane-pi-agent" "$ROOT/assets/worklane-pi-install" \
  "$ROOT/assets/worklane-ide" "$ROOT/assets/worklane-appearance" \
  "$ROOT/assets/worklane-ide-init.lua" "$LAB_SSH:$REMOTE_PROJECT/assets/"
remote "set -eu; cp '$REMOTE_PROJECT/Containerfile' '$REMOTE_DISCOVERY/Containerfile'; cp -a '$REMOTE_PROJECT/assets' '$REMOTE_DISCOVERY/assets'; printf '%s\n' 'FROM scratch' 'COPY marker /marker' >'$REMOTE_SMOKE/Containerfile'; printf '%s\n' acceptance-fixture >'$REMOTE_SMOKE/marker'"
remote "chmod 755 '$REMOTE_ROOT/bin/worklane' '$REMOTE_ROOT/bin/lane' '$REMOTE_ROOT/bin/worklane-mcp'; '$REMOTE_ROOT/bin/worklane' --help >/dev/null; '$REMOTE_ROOT/bin/worklane-mcp' --help >/dev/null; podman --version; gh --version | head -1"

export XDG_DATA_HOME="$LOCAL_ROOT/data" XDG_CONFIG_HOME="$LOCAL_ROOT/config"
run "$CANDIDATE_WORKLANE" --json registry init --fresh; pass registry.init
run "$CANDIDATE_WORKLANE" --json host add lab --ssh "$LAB_SSH"; pass host.add
run "$CANDIDATE_WORKLANE" --json host list; pass host.list
run "$CANDIDATE_WORKLANE" --json host bootstrap lab; pass host.bootstrap

# Deploy is tested before status so a clean lab account need not have Worklane preinstalled.
# The isolated copy remains the acceptance executor.
OLD_DEPLOY_TARGET=$(/usr/bin/ssh "${SSH_OPTIONS[@]}" "$LAB_SSH" 'readlink "$HOME/.local/bin/worklane" || true')
printf '%s\n' "$OLD_DEPLOY_TARGET" >"$ARTIFACT_DIR/previous-deploy-target.txt"
run "$CANDIDATE_WORKLANE" --json host deploy lab --binary "$CANDIDATE_WORKLANE"; pass host.deploy
run "$CANDIDATE_WORKLANE" --json host status
"$CANDIDATE_WORKLANE" --json host status | jq -e 'all(.[]; .reachable == true)' >/dev/null
pass host.status

R="env XDG_DATA_HOME='$REMOTE_ROOT/data' XDG_CONFIG_HOME='$REMOTE_ROOT/config' CODEX_HOME='$REMOTE_ROOT/credentials/codex' GH_CONFIG_DIR='$REMOTE_ROOT/credentials/gh' PATH='$REMOTE_ROOT/bin:/usr/local/bin:/usr/bin:/bin'"
remote "$R '$REMOTE_ROOT/bin/worklane' --json registry init --fresh"; pass registry.init
phase_end
phase_start image_no_cache_fixture
remote "$R '$REMOTE_ROOT/bin/worklane' --json image build --file '$REMOTE_SMOKE/Containerfile' --context '$REMOTE_SMOKE' --tag '$SMOKE_IMAGE_TAG' --no-cache"; pass image.build.no_cache
phase_end
phase_start image_fresh
remote "$R EDITOR=true '$REMOTE_ROOT/bin/worklane' --json image edit"; pass image.edit
remote "$R '$REMOTE_ROOT/bin/worklane' --json image build --file '$REMOTE_PROJECT/Containerfile' --context '$REMOTE_PROJECT' --tag '$IMAGE_TAG'"; pass image.build
remote "$R '$REMOTE_ROOT/bin/worklane' --json image inspect '$IMAGE_TAG'"; pass image.inspect
remote "test \"\$(df -Pk '$REMOTE_HOME' | awk 'NR==2 {print \$4}')\" -ge '$MIN_FREE_KIB'"
phase_end
phase_start lane_create

remote "$R '$REMOTE_ROOT/bin/worklane' --json lane create '$LANE_NAME' --project '$REMOTE_PROJECT' --profile acceptance"; pass lane.create
remote "$R '$REMOTE_ROOT/bin/worklane' --json lane create '$LANE_NAME' --project '$REMOTE_PROJECT' --profile acceptance"; pass lane.create.retry
phase_end
phase_start lane_lifecycle_and_upgrades
remote "set -eu; mkdir -p '$REMOTE_PROJECT/.config/systemd/user' '$REMOTE_PROJECT/.local/state'; printf '%s\n' '[Unit]' 'Description=Worklane persistence acceptance' '' '[Service]' 'Type=oneshot' 'ExecStart=/usr/bin/touch /home/dev/.local/state/worklane-systemd-persisted' 'RemainAfterExit=yes' '' '[Install]' 'WantedBy=default.target' >'$REMOTE_PROJECT/.config/systemd/user/worklane-persistence-acceptance.service'; container=\$(podman ps --filter 'label=io.worklane.name=$SESSION_NAME' --format '{{.Names}}'); uid=1001; podman exec --user dev --env XDG_RUNTIME_DIR=/run/user/\$uid --env DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$uid/bus \"\$container\" systemctl --user daemon-reload; podman exec --user dev --env XDG_RUNTIME_DIR=/run/user/\$uid --env DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$uid/bus \"\$container\" systemctl --user enable --now worklane-persistence-acceptance.service"; pass runtime.user_units
for feature in lane.list lane.inspect lane.refresh lane.diff lane.diff.raw lane.stop lane.start lane.reconcile lane.reconcile.apply; do
  case "$feature" in
    lane.list) args="lane list";; lane.inspect) args="lane inspect '$LANE_NAME'";; lane.refresh) args="lane refresh '$LANE_NAME'";;
    lane.diff) args="lane diff '$LANE_NAME'";; lane.diff.raw) args="lane diff '$LANE_NAME' --raw";; lane.stop) args="lane stop '$LANE_NAME'";;
    lane.start) args="lane start '$LANE_NAME'";; lane.reconcile) args="lane reconcile '$LANE_NAME'";; lane.reconcile.apply) args="lane reconcile '$LANE_NAME' --apply";;
  esac
  remote "$R '$REMOTE_ROOT/bin/worklane' --json $args"; pass "$feature"
done
remote "$R '$REMOTE_ROOT/bin/worklane' --json lane refresh --all"; pass lane.refresh.all
remote "$R '$REMOTE_ROOT/bin/worklane' --json lane rename '$LANE_NAME' '${LANE_NAME}-r'"; LANE_NAME="${LANE_NAME}-r"; pass lane.rename
remote "$R sh -c 'printf \"exit\\n\" | script -qec \"$REMOTE_ROOT/bin/worklane lane attach $LANE_NAME --shell\" /dev/null'"; pass lane.attach.shell

# Verify the embedded reference bundle, then protect custom active instructions across attaches.
remote "set -eu; docs='$REMOTE_PROJECT/.local/share/worklane/agent-docs/current'; test -L \"\$docs\"; for name in lane.md automation.md MIGRATE.md REVISION; do test -s \"\$docs/\$name\"; done; grep -q 'CPU-only lane' \"\$docs/lane.md\"; test \"\$(wc -l <\"\$docs/lane.md\")\" -le 50; grep -q 'Use normal' \"\$docs/lane.md\"; grep -q 'questionnaire' \"\$docs/lane.md\"; if grep -q scripts/release-check '$REMOTE_PROJECT/.codex/AGENTS.md'; then exit 1; fi; printf '%s\\n' '# Custom acceptance rule' >>'$REMOTE_PROJECT/.codex/AGENTS.md'; cp '$REMOTE_PROJECT/.codex/AGENTS.md' '$REMOTE_ROOT/agent-custom.md'; printf '%s\\n' '# Acceptance override' >'$REMOTE_PROJECT/.codex/AGENTS.override.md'; cp '$REMOTE_PROJECT/.codex/AGENTS.override.md' '$REMOTE_ROOT/agent-override.md'"
pass runtime.agent_guidance
remote "$R '$REMOTE_ROOT/bin/worklane' --json lane upgrade '$LANE_NAME' --force"; pass lane.upgrade; pass lane.upgrade.force
remote "$R '$REMOTE_ROOT/bin/worklane' --json lane upgrade --all"; pass lane.upgrade.all
phase_end
phase_start runtime_and_api
remote "set -eu; container=\$(podman ps --filter 'label=io.worklane.name=$SESSION_NAME' --format '{{.Names}}'); uid=1001; test -f '$REMOTE_PROJECT/.local/state/worklane-systemd-persisted'; podman exec --user dev --env XDG_RUNTIME_DIR=/run/user/\$uid --env DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$uid/bus \"\$container\" systemctl --user is-enabled worklane-persistence-acceptance.service; podman exec --user dev --env XDG_RUNTIME_DIR=/run/user/\$uid --env DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$uid/bus \"\$container\" systemctl --user is-active worklane-persistence-acceptance.service"; pass runtime.user_units.persist

remote "$R sh -c 'printf \"\\002q\" | script -qec \"$REMOTE_ROOT/bin/worklane lane attach $LANE_NAME\" /dev/null'"; pass lane.attach.herdr
remote "$R sh -c 'printf \"\\002q\" | script -qec \"$REMOTE_ROOT/bin/worklane lane attach $LANE_NAME\" /dev/null'"; pass lane.attach.repeat
run scp "${SSH_OPTIONS[@]}" -q "$ROOT/tests/connector_acceptance.py" "$LAB_SSH:$REMOTE_ROOT/connector_acceptance.py"
remote "$R python3 '$REMOTE_ROOT/connector_acceptance.py' '$REMOTE_ROOT/bin/worklane' '$REMOTE_ROOT/bin/worklane-mcp' '$LANE_NAME'"
pass api.lifecycle
pass api.jobs
pass api.herdr
pass api.shell
pass api.codex
pass mcp.streamable_http
pass mcp.tools
remote "set -eu; cmp '$REMOTE_ROOT/agent-custom.md' '$REMOTE_PROJECT/.codex/AGENTS.md'; cmp '$REMOTE_ROOT/agent-override.md' '$REMOTE_PROJECT/.codex/AGENTS.override.md'; test -s '$REMOTE_PROJECT/.local/share/worklane/agent-docs/current/MIGRATE.md'"
pass runtime.agent_guidance.preserve
remote "$R sh -c 'container=\$(podman ps --filter \"label=io.worklane.name=$SESSION_NAME\" --format \"{{.Names}}\"); test -n \"\$container\"; test \"\$(podman exec --user dev --workdir /home/dev \"\$container\" gh auth token)\" = worklane-acceptance-fixture'"; pass credentials.github
remote "$R sh -c 'container=\$(podman ps --filter \"label=io.worklane.name=$SESSION_NAME\" --format \"{{.Names}}\"); test \"\$(podman exec --user dev --workdir /home/dev \"\$container\" jq -r .OPENAI_API_KEY /home/dev/.codex/auth.json)\" = worklane-acceptance-fixture'"
remote "set -eu; container=\$(podman ps --filter 'label=io.worklane.name=$SESSION_NAME' --format '{{.Names}}'); printf '%s\n' '{\"OPENAI_API_KEY\":\"worklane-acceptance-rotated\"}' >'$REMOTE_ROOT/credentials/codex/auth.next'; mv '$REMOTE_ROOT/credentials/codex/auth.next' '$REMOTE_ROOT/credentials/codex/auth.json'; test \"\$(podman exec --user dev \"\$container\" jq -r .OPENAI_API_KEY /home/dev/.codex/auth.json)\" = worklane-acceptance-rotated; test \"\$(podman exec --user dev \"\$container\" readlink /home/dev/.codex/auth.json)\" = /run/worklane-host-codex/auth.json; ! podman exec --user dev \"\$container\" sh -c 'printf denied > /run/worklane-host-codex/auth.json' >/dev/null 2>&1; podman exec --user dev \"\$container\" rm /home/dev/.codex/auth.json; podman exec --user dev \"\$container\" codex --version >/dev/null; test \"\$(podman exec --user dev \"\$container\" readlink /home/dev/.codex/auth.json)\" = /run/worklane-host-codex/auth.json"
pass credentials.codex
remote "set -eu; container=\$(podman ps --filter 'label=io.worklane.name=$SESSION_NAME' --format '{{.Names}}'); expected=\$(podman exec \"\$container\" cat /etc/worklane/codex-version); actual=\$(podman exec \"\$container\" codex-real --version); test \"\$actual\" = \"codex-cli \$expected\""
remote "$R podman inspect --format '{{.State.StartedAt}}' \$(podman ps --filter 'label=io.worklane.name=$SESSION_NAME' --format '{{.Names}}')"; pass runtime.timestamp
remote "set -eu; container=\$(podman ps --filter 'label=io.worklane.name=$SESSION_NAME' --format '{{.Names}}'); test \"\$(podman exec \"\$container\" readlink -f /etc/localtime)\" = \"\$(readlink -f /etc/localtime)\"; test \"\$(podman exec \"\$container\" date +%z)\" = \"\$(date +%z)\""; pass runtime.timezone
remote "$R podman exec --workdir /home/dev \$(podman ps --filter 'label=io.worklane.name=$SESSION_NAME' --format '{{.Names}}') sh -c 'test -w /home/dev && ! test -w /usr'"; pass runtime.immutable_root; pass runtime.mounts
remote "set -eu; container=\$(podman ps --filter 'label=io.worklane.name=$SESSION_NAME' --format '{{.Names}}'); uid=1001; test \"\$(podman exec \"\$container\" ps -p 1 -o comm= | tr -d ' ')\" = systemd; podman exec --user dev --env XDG_RUNTIME_DIR=/run/user/\$uid --env DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$uid/bus \"\$container\" systemctl --user is-active worklane-herdr.service; podman exec --user dev --env XDG_RUNTIME_DIR=/run/user/\$uid --env DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$uid/bus \"\$container\" systemd-run --user --wait --collect --unit worklane-acceptance-transient --property RuntimeMaxSec=30s --property TasksMax=32 /usr/bin/true; ! podman exec --user dev \"\$container\" systemctl --no-ask-password daemon-reload"; pass runtime.systemd; pass runtime.user_manager; pass runtime.system_scope_denied
remote "set -eu; container=\$(podman ps --filter 'label=io.worklane.name=$SESSION_NAME' --format '{{.Names}}'); uid=1001; expected=14745; user_limit=\$(podman exec \"\$container\" systemctl show \"user-\$uid.slice\" --property TasksMax --value); herdr_limit=\$(podman exec --user dev --env XDG_RUNTIME_DIR=/run/user/\$uid --env DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$uid/bus \"\$container\" systemctl --user show worklane-herdr.service --property TasksMax --value); podman exec --user dev --env XDG_RUNTIME_DIR=/run/user/\$uid --env DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$uid/bus \"\$container\" systemd-run --user --unit worklane-acceptance-default-tasks --property RuntimeMaxSec=30s /usr/bin/sleep 30; transient_limit=\$(podman exec --user dev --env XDG_RUNTIME_DIR=/run/user/\$uid --env DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$uid/bus \"\$container\" systemctl --user show worklane-acceptance-default-tasks.service --property TasksMax --value); podman exec --user dev --env XDG_RUNTIME_DIR=/run/user/\$uid --env DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$uid/bus \"\$container\" systemctl --user stop worklane-acceptance-default-tasks.service; test \"\$user_limit\" -eq \"\$expected\"; test \"\$herdr_limit\" -eq \"\$expected\"; test \"\$transient_limit\" -eq \"\$expected\""; pass runtime.task_limits
remote "set -eu; container=\$(podman ps --filter 'label=io.worklane.name=$SESSION_NAME' --format '{{.Names}}'); uid=1001; before=\$(podman exec --user dev --env XDG_RUNTIME_DIR=/run/user/\$uid --env DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$uid/bus \"\$container\" systemctl --user show --property MainPID --value worklane-herdr.service); test \"\$before\" -gt 0; podman exec --user dev --env XDG_RUNTIME_DIR=/run/user/\$uid --env DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$uid/bus \"\$container\" systemctl --user kill --signal=KILL --kill-whom=main worklane-herdr.service; i=0; while test \"\$i\" -lt 50; do after=\$(podman exec --user dev --env XDG_RUNTIME_DIR=/run/user/\$uid --env DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$uid/bus \"\$container\" systemctl --user show --property MainPID --value worklane-herdr.service); test \"\$after\" -gt 0 2>/dev/null && test \"\$after\" != \"\$before\" && break; sleep 0.2; i=\$((i + 1)); done; test \"\$after\" -gt 0; test \"\$after\" != \"\$before\""; pass runtime.herdr_supervision
remote "$R podman exec --user dev --workdir /home/dev \$(podman ps --filter 'label=io.worklane.name=$SESSION_NAME' --format '{{.Names}}') sh -c 'i=0; s=; while test \"\$i\" -lt 30; do s=\$(herdr --session \"$SESSION_NAME\" api snapshot 2>/dev/null || true); primary=\$(printf %s \"\$s\" | jq \"[.result.snapshot.panes[]? | select((.label // \\\"\\\") != \\\"git diff\\\")] | length\" 2>/dev/null || true); diff=\$(printf %s \"\$s\" | jq \"[.result.snapshot.panes[]? | select((.label // \\\"\\\") == \\\"git diff\\\")] | length\" 2>/dev/null || true); test \"\$primary\" -ge 1 && test \"\$diff\" -ge 1 && exit 0; i=\$((i + 1)); sleep 1; done; printf \"Herdr layout did not recover:\\n%s\\n\" \"\$s\" >&2; exit 1'"; pass herdr.layout.two_panes
remote "$R podman exec --user dev --workdir /home/dev \$(podman ps --filter 'label=io.worklane.name=$SESSION_NAME' --format '{{.Names}}') sh -c 'set -e; git --version; node --version; python3 --version; cargo --version; pi --version; codex --version; curl -fsSI https://github.com >/dev/null'"; pass runtime.tools; pass runtime.network
remote "set -eu; container=\$(podman ps --filter 'label=io.worklane.name=$SESSION_NAME' --format '{{.Names}}'); expected_pi=\$(podman exec \"\$container\" cat /etc/worklane/pi-version); actual_pi=\$(podman exec \"\$container\" pi --version); test \"\$actual_pi\" = \"\$expected_pi\"; expected_web=\$(podman exec \"\$container\" cat /etc/worklane/pi-web-version); actual_web=\$(podman exec \"\$container\" node -p 'require(\"/opt/worklane/pi-seed/node_modules/pi-web-access/package.json\").version'); test \"\$actual_web\" = \"\$expected_web\""; pass runtime.pi_versions
