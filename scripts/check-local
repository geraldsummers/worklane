#!/usr/bin/env bash
set -Eeuo pipefail

MODE=${1:---quick}
case "$MODE" in
  --quick|--full) ;;
  *) echo "usage: scripts/check-local [--quick|--full]" >&2; exit 2 ;;
esac
ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"
if [[ -d /home/dev && -w /home/dev ]]; then
  mkdir -p /home/dev/.tmp
  if [[ -w /home/dev/.tmp ]]; then
    export TMPDIR=/home/dev/.tmp
  fi
fi
if [[ -n ${WORKLANE_RUST_TOOLCHAIN:-} ]]; then
  CARGO=(rustup run "$WORKLANE_RUST_TOOLCHAIN" cargo)
else
  CARGO=(cargo)
fi

"${CARGO[@]}" fmt --check
"${CARGO[@]}" clippy --workspace --all-targets -- -D warnings
if [[ $MODE == --full ]]; then
  command -v cargo-llvm-cov >/dev/null || { echo "cargo-llvm-cov is required for --full" >&2; exit 1; }
  "${CARGO[@]}" llvm-cov --workspace --fail-under-lines 90 -- --test-threads=1
else
  "${CARGO[@]}" test --workspace
fi
python3 -m unittest discover -s tests -p "test_*.py"
# Tests/typecheck load the exact locked SDK, not an arbitrary host Pi version.
PI_VALIDATION="$ROOT/.tmp/pi-validation"
mkdir -p "$PI_VALIDATION"
if ! cmp -s assets/pi-bundle/package-lock.json "$PI_VALIDATION/package-lock.json" || [[ ! -d "$PI_VALIDATION/node_modules/typescript" ]]; then
  cp assets/pi-bundle/package.json assets/pi-bundle/package-lock.json "$PI_VALIDATION/"
  npm ci --prefix "$PI_VALIDATION" --ignore-scripts --no-audit --no-fund
fi
node tests/run-pi-extensions.mjs --typecheck
node tests/run-pi-extensions.mjs
bash -n scripts/lab-acceptance scripts/release-check scripts/check-local
python3 -c "import ast, pathlib; ast.parse(pathlib.Path(\"scripts/tui_capture.py\").read_text())"
shellcheck scripts/lab-acceptance scripts/release-check scripts/check-local
