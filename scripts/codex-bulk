#!/usr/bin/env python3
"""Run independent JSONL records through codex exec with adaptive concurrency."""

from __future__ import annotations

import argparse
import asyncio
from collections import deque
from dataclasses import dataclass
import json
import os
from pathlib import Path
import random
import signal
import sys
import time
from typing import Any


RATE_LIMIT_MARKERS = ("429 too many requests", "exceeded retry limit")


@dataclass
class Job:
    record_id: str
    record: dict[str, Any]
    attempts_done: int = 0
    first_attempt_at: float = 0.0


@dataclass
class RunResult:
    returncode: int
    stdout: str
    stderr: str

    @property
    def rate_limited(self) -> bool:
        message = self.stderr.lower()
        return any(marker in message for marker in RATE_LIMIT_MARKERS)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Bulk-delegate JSONL records to Codex with adaptive 429 backoff."
    )
    parser.add_argument("input", help="Input JSONL path, or - for stdin")
    parser.add_argument("--output", required=True, help="Append-only result JSONL path")
    parser.add_argument("--schema", required=True, help="JSON Schema for each Codex result")
    parser.add_argument("--prompt", required=True, help="Instruction applied to every record")
    parser.add_argument("--id-field", default="id")
    parser.add_argument("--codex", default="codex", help="Codex executable")
    parser.add_argument("--model", default="gpt-5.6-luna")
    parser.add_argument("--reasoning-effort", default="low")
    parser.add_argument("--initial-workers", type=int, default=4)
    parser.add_argument("--max-workers", type=int, default=256)
    parser.add_argument("--success-window", type=int, default=32)
    parser.add_argument("--cooldown", type=float, default=60.0)
    parser.add_argument("--jitter", type=float, default=10.0)
    parser.add_argument("--max-attempts", type=int, default=3)
    parser.add_argument("--max-retry-seconds", type=float, default=900.0)
    return parser.parse_args()


def validate_args(args: argparse.Namespace) -> None:
    for name in ("initial_workers", "max_workers", "success_window", "max_attempts"):
        if getattr(args, name) < 1:
            raise ValueError(f"--{name.replace('_', '-')} must be at least 1")
    if args.max_workers > 256:
        raise ValueError("--max-workers cannot exceed the hard ceiling of 256")
    if args.initial_workers > args.max_workers:
        raise ValueError("--initial-workers cannot exceed --max-workers")
    if args.cooldown < 0 or args.jitter < 0 or args.max_retry_seconds < 0:
        raise ValueError("cooldown, jitter, and retry duration cannot be negative")
    if not Path(args.schema).is_file():
        raise ValueError(f"schema does not exist: {args.schema}")


def read_records(path: str, id_field: str) -> list[Job]:
    source = sys.stdin if path == "-" else open(path, encoding="utf-8")
    try:
        jobs: list[Job] = []
        seen: set[str] = set()
        for line_number, line in enumerate(source, 1):
            if not line.strip():
                continue
            value = json.loads(line)
            if not isinstance(value, dict):
                raise ValueError(f"line {line_number}: expected a JSON object")
            if id_field not in value:
                raise ValueError(f"line {line_number}: missing {id_field!r}")
            record_id = str(value[id_field])
            if record_id in seen:
                raise ValueError(f"line {line_number}: duplicate ID {record_id!r}")
            seen.add(record_id)
            jobs.append(Job(record_id, value))
        return jobs
    finally:
        if source is not sys.stdin:
            source.close()


def restore_state(path: Path, jobs: list[Job]) -> None:
    if not path.exists():
        return
    by_id = {job.record_id: job for job in jobs}
    completed: set[str] = set()
    with path.open(encoding="utf-8") as stream:
        for line_number, line in enumerate(stream, 1):
            if not line.strip():
                continue
            try:
                event = json.loads(line)
            except json.JSONDecodeError as error:
                raise ValueError(f"{path}:{line_number}: invalid result JSONL") from error
            record_id = str(event.get("id", ""))
            job = by_id.get(record_id)
            if job is None:
                continue
            if event.get("status") == "ok":
                completed.add(record_id)
            elif event.get("status") == "retrying":
                job.attempts_done = max(job.attempts_done, int(event.get("attempts", 0)))
                started = float(event.get("first_attempt_at", 0))
                if started and (not job.first_attempt_at or started < job.first_attempt_at):
                    job.first_attempt_at = started
    jobs[:] = [job for job in jobs if job.record_id not in completed]


async def stop_process_group(process: asyncio.subprocess.Process) -> None:
    if process.returncode is not None:
        return
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    try:
        await asyncio.wait_for(process.wait(), timeout=5)
    except asyncio.TimeoutError:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        await process.wait()


async def run_job(args: argparse.Namespace, job: Job) -> RunResult:
    command = [
        args.codex,
        "exec",
        "--ephemeral",
        "--model",
        args.model,
        "-c",
        f'model_reasoning_effort="{args.reasoning_effort}"',
        "--output-schema",
        str(Path(args.schema).resolve()),
        args.prompt,
    ]
    process = await asyncio.create_subprocess_exec(
        *command,
        stdin=asyncio.subprocess.PIPE,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE,
        start_new_session=True,
    )
    try:
        remaining = max(0.001, args.max_retry_seconds - (time.time() - job.first_attempt_at))
        stdout, stderr = await asyncio.wait_for(
            process.communicate(
                (json.dumps(job.record, separators=(",", ":")) + "\n").encode()
            ),
            timeout=remaining,
        )
    except asyncio.TimeoutError:
        await stop_process_group(process)
        return RunResult(124, "", "record exceeded --max-retry-seconds")
    except asyncio.CancelledError:
        await stop_process_group(process)
        raise
    return RunResult(
        process.returncode,
        stdout.decode(errors="replace").strip(),
        stderr.decode(errors="replace").strip(),
    )


def append_event(stream: Any, event: dict[str, Any]) -> None:
    stream.write(json.dumps(event, separators=(",", ":"), sort_keys=True) + "\n")
    stream.flush()
    os.fsync(stream.fileno())


async def schedule(args: argparse.Namespace, jobs: list[Job], output: Path) -> int:
    pending = deque(jobs)
    active: dict[asyncio.Task[RunResult], Job] = {}
    target = args.initial_workers
    success_streak = 0
    cooldown_until = 0.0
    failures = 0
    output.parent.mkdir(parents=True, exist_ok=True)

    with output.open("a", encoding="utf-8") as stream:
        while pending or active:
            now = time.monotonic()
            while pending and len(active) < target and now >= cooldown_until:
                job = pending.popleft()
                job.attempts_done += 1
                if not job.first_attempt_at:
                    job.first_attempt_at = time.time()
                active[asyncio.create_task(run_job(args, job))] = job

            if not active:
                await asyncio.sleep(max(0.05, cooldown_until - time.monotonic()))
                continue

            done, _ = await asyncio.wait(active, return_when=asyncio.FIRST_COMPLETED)
            for task in done:
                job = active.pop(task)
                result = task.result()
                base = {"id": job.record_id, "attempts": job.attempts_done}
                if result.returncode == 0:
                    try:
                        parsed = json.loads(result.stdout)
                    except json.JSONDecodeError:
                        parsed = result.stdout
                    append_event(stream, {**base, "status": "ok", "result": parsed})
                    success_streak += 1
                    if success_streak >= args.success_window:
                        target = min(args.max_workers, target + 1)
                        success_streak = 0
                    continue

                if result.rate_limited:
                    target = max(1, target // 2)
                    success_streak = 0
                    cooldown_until = max(
                        cooldown_until,
                        time.monotonic() + args.cooldown + random.uniform(0, args.jitter),
                    )
                    elapsed = time.time() - job.first_attempt_at
                    if (
                        job.attempts_done < args.max_attempts
                        and elapsed < args.max_retry_seconds
                    ):
                        append_event(
                            stream,
                            {
                                **base,
                                "status": "retrying",
                                "first_attempt_at": job.first_attempt_at,
                                "error": result.stderr[-8000:],
                            },
                        )
                        pending.append(job)
                        continue

                failures += 1
                append_event(
                    stream,
                    {
                        **base,
                        "status": "error",
                        "exit_code": result.returncode,
                        "error": result.stderr[-8000:],
                    },
                )
    return 1 if failures else 0


def main() -> int:
    args = parse_args()
    try:
        validate_args(args)
        jobs = read_records(args.input, args.id_field)
        output = Path(args.output)
        restore_state(output, jobs)
        return asyncio.run(schedule(args, jobs, output))
    except (OSError, ValueError, json.JSONDecodeError) as error:
        print(f"codex-bulk: {error}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        print("codex-bulk: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
